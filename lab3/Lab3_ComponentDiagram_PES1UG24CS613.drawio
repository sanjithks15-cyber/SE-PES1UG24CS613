        <mxCell id="box164" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;•  Rectangle with the component icon (top-right) = «component»;  outer box = «subsystem»&lt;br&gt;•  Small square on a boundary = port (interaction point between a component and its environment)&lt;br&gt;•  Ball on a stick ─● = provided interface;  socket on a stick ─( = required interface&lt;br&gt;•  Dashed arrow between socket and ball = usage dependency «use» across a subsystem boundary&lt;br&gt;•  Ball seated in a socket = assembly connector between two components inside one subsystem&lt;br&gt;•  Solid line from a port into a subsystem = delegation connector to the component that realises it" style="rounded=0;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="140" y="1150" width="680" height="150" as="geometry" />
        </mxCell>
        <mxCell id="box167" value="&lt;b&gt;NFR-001 — Performance&lt;/b&gt;&lt;br&gt;:CatalogSearchEngine answers through its own inverted index, so paginated&lt;br&gt;results over 50,000 titles return in &lt; 150 ms without touching the&lt;br&gt;transactional write path in :LibraryDataStore." style="rounded=0;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="860" y="1150" width="520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="box168" value="&lt;b&gt;NFR-002 — Security&lt;/b&gt;&lt;br&gt;:PaymentService owns the only TLS 1.2+ link to :PaymentGateway, so no card&lt;br&gt;data reaches the UI. :AuthMemberService is the single credential entry point&lt;br&gt;and enforces the 15-minute lockout after 5 failed logins." style="rounded=0;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1420" y="1150" width="440" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
